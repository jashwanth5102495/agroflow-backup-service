  "description": "AgroFlow Isolated Backup Node - Read-only mirror of the primary database. This service ONLY appends data and NEVER deletes or overwrites.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "mongoose": "^9.9.2",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.2.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
